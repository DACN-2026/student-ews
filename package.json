{
  "name": "student-monitoring-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/run-apps.cjs dev",
    "dev:frontend": "npm run dev --workspace=@sms/frontend",
    "dev:backend": "npm run dev --workspace=@sms/backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=@sms/frontend",
    "build:backend": "npm run build --workspace=@sms/backend",
    "start": "node scripts/run-apps.cjs start",
    "start:frontend": "npm run start --workspace=@sms/frontend",
    "start:backend": "npm run start --workspace=@sms/backend",
    "lint": "npm run lint --workspaces",
    "lint:backend": "npm run lint --workspace=@sms/backend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:smoke": "node scripts/smoke-test.cjs",
    "db:generate": "npm run db:generate --workspace=@sms/backend",
    "db:migrate": "npm run db:migrate --workspace=@sms/backend",
    "db:deploy": "npm run db:deploy --workspace=@sms/backend",
    "db:push": "npm run db:push --workspace=@sms/backend",
    "db:seed": "npm run db:seed --workspace=@sms/backend",
    "db:import-apidog": "npm run db:import-apidog --workspace=@sms/backend",
    "db:check-apidog": "npm run db:check-apidog --workspace=@sms/backend",
    "db:sync-apidog-progress": "npm run db:sync-apidog-progress --workspace=@sms/backend",
    "db:sync-apidog-graduation": "npm run db:sync-apidog-graduation --workspace=@sms/backend",
    "db:remove-seed-demo": "npm run db:remove-seed-demo --workspace=@sms/backend",
    "db:studio": "npm run db:studio --workspace=@sms/backend"
  }
}
