{
  "name": "@sms/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint app lib proxy.ts tests next.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/run-tests.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:import-apidog": "node scripts/import-apidog-data.cjs --apply",
    "db:check-apidog": "node scripts/import-apidog-data.cjs",
    "db:sync-apidog-progress": "tsx scripts/sync-apidog-training-progress.ts",
    "db:sync-apidog-graduation": "node -r ./scripts/node-platform-shim.cjs --import tsx scripts/sync-apidog-graduation-evaluations.ts",
    "db:remove-seed-demo": "tsx scripts/sync-apidog-training-progress.ts --remove-legacy-demo",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@prisma/client": "^6.11.0",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "jose": "^6.0.0",
    "next": "16.3.4",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
