generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Student {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sStudentId          String    @map("s_student_id") @db.VarChar(32)
  sFirstName          String    @map("s_first_name") @db.VarChar(120)
  sLastName           String    @map("s_last_name") @db.VarChar(200)
  sFullName           String    @map("s_full_name") @db.VarChar(320)
  sBirthDate          DateTime  @map("s_birth_date") @db.Date
  sBirthPlace         String?   @map("s_birth_place") @db.VarChar(255)
  sGender             String?   @map("s_gender") @db.VarChar(32)
  sClassRoleId        Int       @default(0) @map("s_class_role_id") @db.SmallInt
  sPermanentResidence String?   @map("s_permanent_residence")
  sIsInClass          Boolean   @default(true) @map("s_is_in_class")
  sClassStudentId     String?   @map("s_class_student_id") @db.VarChar(64)
  sStudyProgramId     String?   @map("s_study_program_id") @db.VarChar(64)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([sIsInClass, sClassRoleId, sGender, updatedAt(sort: Desc)], map: "students_filters_idx")
  @@map("students")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId      String?  @map("actor_id") @db.VarChar(128)
  action       String   @db.VarChar(64)
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String?  @map("resource_id") @db.Uuid
  requestId    String?  @map("request_id") @db.VarChar(128)
  details      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resourceType, resourceId, createdAt(sort: Desc)], map: "audit_logs_resource_idx")
  @@map("audit_logs")
}

model Class {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId   String    @unique(map: "classes_s_class_student_id_key") @map("class_id") @db.VarChar(64)
  className String    @map("class_name") @db.VarChar(320)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  cohortId  String?   @map("cohort_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")

  @@map("classes")
}

model Cohort {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sCohortCode String    @unique @map("s_cohort_code") @db.VarChar(64)
  sCohortName String    @map("s_cohort_name") @db.VarChar(320)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  isActive    Boolean   @default(true) @map("is_active")

  @@map("cohorts")
}

model TrainingProgram {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sProgramCode   String    @unique @map("s_program_code") @db.VarChar(64)
  sProgramName   String    @map("s_program_name") @db.VarChar(320)
  sDegreeLevel   String    @map("s_degree_level") @db.VarChar(128)
  sMajor         String    @map("s_major") @db.VarChar(255)
  sStudyType     String    @map("s_study_type") @db.VarChar(128)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  s_faculty_code String?   @db.VarChar(64)
  isActive       Boolean   @default(true) @map("is_active")
  status         String    @default("active") @db.VarChar(16)

  @@map("training_programs")
}

model Course {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sCourseCode String    @unique @map("s_course_code") @db.VarChar(64)
  sCourseName String    @map("s_course_name") @db.VarChar(320)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("courses")
}

model TrainingProgramCourse {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trainingProgramId String   @map("training_program_id") @db.Uuid
  courseId          String   @map("course_id") @db.Uuid
  sSemesterNo       Int      @map("s_semester_no") @db.SmallInt
  sCredits          Int      @map("s_credits") @db.SmallInt
  sTheoryHours      Int?     @map("s_theory_hours") @db.SmallInt
  sPracticeHours    Int?     @map("s_practice_hours") @db.SmallInt
  sRequirementType  String   @map("s_requirement_type") @db.VarChar(32)
  sNote             String?  @map("s_note")
  sYearStudy        String?  @map("s_year_study") @db.VarChar(32)
  sTermId           String?  @map("s_term_id") @db.VarChar(32)
  sDepartmentCode   String?  @map("s_department_code") @db.VarChar(64)
  sFacultyCode      String?  @map("s_faculty_code") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  academicTermId    String?  @map("academic_term_id") @db.Uuid

  @@unique([trainingProgramId, courseId])
  @@index([trainingProgramId, sSemesterNo], map: "training_program_courses_semester_idx")
  @@index([academicTermId], map: "training_program_courses_term_idx")
  @@map("training_program_courses")
}

model AcademicYear {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sYearCode String    @unique @map("s_year_code") @db.VarChar(9)
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  status    String    @default("draft") @db.VarChar(16)
  isCurrent Boolean   @default(false) @map("is_current")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("academic_years")
}

model AcademicTerm {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  sTermCode      String    @map("s_term_code") @db.VarChar(8)
  sTermName      String    @map("s_term_name") @db.VarChar(64)
  sTermOrder     Int       @map("s_term_order") @db.SmallInt
  sIsSummer      Boolean   @default(false) @map("s_is_summer")
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  status         String    @default("draft") @db.VarChar(16)
  isCurrent      Boolean   @default(false) @map("is_current")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([academicYearId, sTermCode])
  @@unique([academicYearId, sTermOrder])
  @@unique([id, academicYearId], map: "academic_terms_id_year_key")
  @@map("academic_terms")
}

model GradeImportBatch {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceHash     String    @map("source_hash") @db.VarChar(64)
  status         String    @db.VarChar(16)
  totalRows      Int       @default(0) @map("total_rows")
  importedRows   Int       @default(0) @map("imported_rows")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  idempotencyKey String?   @map("idempotency_key") @db.VarChar(128)

  @@map("grade_import_batches")
}

model UnscopedGradeRecord {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String   @map("student_id") @db.Uuid
  sStudentId         String   @map("s_student_id") @db.VarChar(32)
  sCourseCode        String?  @map("s_course_code") @db.VarChar(64)
  sCourseName        String?  @map("s_course_name") @db.VarChar(320)
  sCredits           Int?     @map("s_credits") @db.SmallInt
  reason             String   @db.VarChar(128)
  sourcePayload      Json     @default("{}") @map("source_payload")
  sourceMd5          String?  @map("source_md5") @db.VarChar(64)
  gradeImportBatchId String?  @map("grade_import_batch_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([studentId], map: "unscoped_grade_records_student_idx")
  @@index([gradeImportBatchId], map: "unscoped_grade_records_batch_idx")
  @@map("unscoped_grade_records")
}

model StudentCourseOffering {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId            String   @map("student_id") @db.Uuid
  academicYearId       String   @map("academic_year_id") @db.Uuid
  academicTermId       String   @map("academic_term_id") @db.Uuid
  courseId             String   @map("course_id") @db.Uuid
  sStudentId           String   @map("s_student_id") @db.VarChar(32)
  sProgramCode         String?  @map("s_program_code") @db.VarChar(64)
  sCurriculumId        String   @map("s_curriculum_id") @db.VarChar(64)
  sStudyUnitId         String   @map("s_study_unit_id") @db.VarChar(64)
  sScheduleStudyUnitId String   @default("") @map("s_schedule_study_unit_id") @db.VarChar(128)
  sCourseName          String   @map("s_course_name") @db.VarChar(320)
  sCourseNameEng       String?  @map("s_course_name_eng") @db.VarChar(320)
  sCourseGroup         String?  @map("s_course_group") @db.VarChar(32)
  sCredits             Int      @map("s_credits") @db.SmallInt
  sourcePayload        Json     @default("{}") @map("source_payload")
  sourceMd5            String?  @map("source_md5") @db.VarChar(64)
  gradeImportBatchId   String?  @map("grade_import_batch_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([studentId, academicTermId, sStudyUnitId, sScheduleStudyUnitId])
  @@index([sCurriculumId, academicYearId, academicTermId], map: "student_course_offerings_course_idx")
  @@index([studentId, academicTermId], map: "student_course_offerings_student_term_idx")
  @@map("student_course_offerings")
}

model StudentCourseGrade {
  offeringId             String   @id @map("offering_id") @db.Uuid
  score10                Decimal? @map("score_10") @db.Decimal(4, 2)
  score4                 Decimal? @map("score_4") @db.Decimal(3, 2)
  letterCode             String?  @map("letter_code") @db.VarChar(8)
  specialCode            String?  @map("special_code") @db.VarChar(16)
  isPass                 Boolean  @default(false) @map("is_pass")
  isGather               Boolean  @default(false) @map("is_gather")
  notScore               Boolean  @default(false) @map("not_score")
  notComputeAverageScore Boolean  @default(false) @map("not_compute_average_score")
  note                   String?
  scoreStatus            String   @map("score_status") @db.VarChar(16)
  sourcePayload          Json     @default("{}") @map("source_payload")
  sourceMd5              String?  @map("source_md5") @db.VarChar(64)
  gradeImportBatchId     String?  @map("grade_import_batch_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("student_course_grades")
}

model StudentTermSummary {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String   @map("student_id") @db.Uuid
  academicTermId     String   @map("academic_term_id") @db.Uuid
  creditsEarned      Decimal? @map("credits_earned") @db.Decimal(8, 2)
