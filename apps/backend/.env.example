# Copy to .env; Next.js and Prisma both read this file.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/cntt-portal?schema=public
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Exact browser origins, separated by commas. Use the HTTPS web origin in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Explicit source convention used only when an import must create a missing term.
# Existing terms always use academic_terms.s_is_summer as the source of truth.
SUMMER_TERM_CODES=HK03
# Optional overrides used only by `npm run db:seed`.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADVISOR_USERNAME=advisor.demo
SEED_ADVISOR_PASSWORD=Advisor@123456
