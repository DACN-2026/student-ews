# Private server-side backend address, read at runtime by proxy and layout.
BACKEND_URL=http://127.0.0.1:3001

# Optional operating convention. When omitted, the UI never infers a summer
# term from its code or order and only uses the explicit "Kỳ hè" flag.
NEXT_PUBLIC_SUMMER_TERM_CODE=HK03
NEXT_PUBLIC_SUMMER_TERM_ORDER=3
